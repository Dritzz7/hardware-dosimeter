(version 1)
# S03 PROVISIONAL Spectra two-layer process. No vendor confirmation yet.
# No ADXL345 exceptions: selected CAM candidate has 0.270mm copper gap.
# Its 0.0668mm nominal mask dam still needs vendor acceptance before production.
(rule "Spectra no micro blind or buried vias"
  (constraint disallow micro_via blind_via buried_via))
(rule "Spectra plane spacing"
  (condition "A.Type == 'Zone'")
  (constraint clearance (min 0.508mm)))
(rule "Spectra thermal relief"
  (constraint thermal_relief_gap (min 0.254mm))
  (constraint thermal_spoke_width (opt 0.30mm)))
