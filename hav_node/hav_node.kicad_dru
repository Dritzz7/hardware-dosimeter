(version 1)
# JLC-03: two-layer FR4, 1oz, green mask, ENIG engineering baseline.
# Existing conservative routing/zone limits retained; no ignored DRC errors.
(rule "HAV two-layer through vias only"
  (constraint disallow micro_via blind_via buried_via))
(rule "HAV conservative plane spacing"
  (condition "A.Type == 'Zone'")
  (constraint clearance (min 0.508mm)))
(rule "HAV thermal relief"
  (constraint thermal_relief_gap (min 0.254mm))
  (constraint thermal_spoke_width (opt 0.30mm)))
# ADI official copper land gap is 0.250mm. Permit 0.200mm locally (JLC 1oz
# SMD pad-to-pad minimum 0.150mm). Not a waiver: DRC still enforces this rule.
# Do not reduce plane spacing or other nets' default 0.254mm clearance.
(rule "ADXL345 official land and fanout"
  (condition "(A.Type == 'Pad' && A.memberOfFootprint('U2') && B.Type != 'Zone') || (B.Type == 'Pad' && B.memberOfFootprint('U2') && A.Type != 'Zone')")
  (constraint clearance (min 0.20mm)))
