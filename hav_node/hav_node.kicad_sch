	)
	(text "SCK GPIO18 -> R4 -> U2.14; MOSI GPIO23 -> R5 -> U2.13\nMISO U2.12 -> GPIO19; CS GPIO25 -> R6 -> U2.7\nINT1 U2.8 -> GPIO35; INT2 hanya ke TP11 pada sheet sensor."
		(exclude_from_sim no)
		(at 30.48 147.32 0)
		(effects
